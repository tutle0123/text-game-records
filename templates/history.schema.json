{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game history 2.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "when",
          "title",
          "detail",
          "personIds",
          "taskIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "personIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
